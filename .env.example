# Public site URL (used for sitemap, canonical URLs, OG images)
NEXT_PUBLIC_SITE_URL=https://www.ingrademedia.com

# TODO: Contact form submission endpoint (Formspree, Resend, or your own API route)
CONTACT_FORM_ENDPOINT=

# TODO: Resend / SMTP credentials if wiring the contact route to send email
RESEND_API_KEY=

# TODO: Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# TODO: Google Site Verification (Search Console)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# TODO: Elfsight Instagram Feed widget ID for the homepage Instagram section.
# From the Elfsight embed snippet's div class "elfsight-app-<this-id>".
# Until this is set, the section falls back to a "Follow us on Instagram" link.
NEXT_PUBLIC_ELFSIGHT_WIDGET_ID=
